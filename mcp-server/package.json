{
  "name": "transaction-forensics-mcp-server",
  "version": "3.0.1",
  "description": "MCP server for Transaction Forensics - exposes tools for multi-system document analysis",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "cd .. && husky mcp-server/.husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.62.1"
  },
  "optionalDependencies": {
    "node-rfc": "^3.3.1"
  },
  "engines": {
    "node": ">=20.0.0 <26"
  },
  "keywords": [
    "mcp",
    "sap",
    "workflow",
    "mining"
  ],
  "author": "",
  "license": "MIT"
}
